<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background color for the splash screen (replace color if you want a different background) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1a1a2e" />
        </shape>
    </item>

    <!-- Centered brand image scaled to fill the screen (preserve aspect ratio by scaling up) -->
    <item android:gravity="center">
        <scale
            android:drawable="@drawable/splash_image"
            android:scaleWidth="100%p"
            android:scaleHeight="100%p"
            android:useIntrinsicSizeAsMinimum="false"
            android:scaleGravity="center" />
    </item>
</layer-list>
